				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
				</Compiler>
				<Linker>
					<Add option="msmpi.lib" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/DNA_Search_Project" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add directory="C:/Program Files (x86)/Microsoft SDKs/MPI/Include" />
		</Compiler>
		<Linker>
			<Add option="msmpi.lib" />
			<Add directory="C:/Program Files (x86)/Microsoft SDKs/MPI/Lib/x64" />
		</Linker>
		<Unit filename="main.c">
			<Option compilerVar="CC" />
		</Unit>
		<Extensions>
			<lib_finder disable_auto="1" />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
